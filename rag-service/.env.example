# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# LLM Configuration - Choose 'ollama' for local or 'groq' for cloud
LLM_PROVIDER=ollama

# Ollama Configuration (FREE - runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Groq Configuration (FREE tier available - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Embedding Configuration (HuggingFace)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
COLLECTION_NAME=visa_documents

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
TEMPERATURE=0.7
MAX_TOKENS=2000

# CORS Configuration (add your frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000

# Logging
LOG_LEVEL=INFO
