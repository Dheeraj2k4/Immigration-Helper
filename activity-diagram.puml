@startuml
title Immigration Helper - Activity Diagram

start

:Open Application;

:Choose Feature;

if (Which Feature?) then (Visa Guide)
  :Enter Query;
  :RAG Processing;
  note right
    Vector Search + 
    Mistral LLM
  end note
  :Show Visa Answer;
  
elseif (Which Feature?) then (Immigration Updates)
  :Fetch Immigration News;
  note right: NewsData.io API
  :Show News Articles;
  
elseif (Which Feature?) then (Checklist)
  :Select Country & Visa Type;
  :Generate Checklist;
  :Show Checklist;
  
else (Browse Guide)
  :View Visa Guides;
endif

:Return to Dashboard;

stop

@enduml
